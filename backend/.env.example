# Porta do Servidor Hermes
PORT=3001
NODE_ENV=development

# Frontend Permitido no CORS (em produção na VPS: http://seu-dominio.com ou http://seu-ip)
CORS_ORIGIN=*

# Google Gemini API
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Supabase (Utilizar a SERVICE_ROLE_KEY no Backend para ter permissão segura de RAG)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_secreta_aqui
